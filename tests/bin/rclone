#!/usr/bin/env python3
"""Fake rclone fuer Tests: protokolliert Aufrufe in $FAKE_RCLONE_LOG.
size --json -> fester Umfang; copy -> legt eine Datei im Ziel an; $FAKE_RCLONE_FAIL=1 -> Exit 1."""
import json
import os
import sys
from pathlib import Path

a = sys.argv[1:]
with open(os.environ.get("FAKE_RCLONE_LOG", os.devnull), "a", encoding="utf-8") as f:
    f.write(json.dumps(a) + "\n")
if os.environ.get("FAKE_RCLONE_FAIL") == "1":
    sys.exit(1)
if a[0] == "size":
    print(json.dumps({"count": 3, "bytes": 3_600_000_000}))
elif a[0] == "copy" and "--dry-run" not in a:
    d = Path(a[2]) / "M 31_sub"
    d.mkdir(parents=True, exist_ok=True)
    (d / "Light_M 31_10.0s_IRCUT_20261018-213000.fit").write_bytes(b"x")
