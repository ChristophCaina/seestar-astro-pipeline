#!/usr/bin/env python3
"""Fake astrometry.net solve-field fuer Tests: schreibt <dir>/<stem>.wcs mit der WCS
des M31-Beispiels; Dateien mit 'unsolvable' im Namen schlagen fehl."""
import json
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(ROOT / "siril" / "lib"))
from fitsheader import write_minimal_fits  # noqa: E402

args = sys.argv[1:]
img = Path(args[-1])
out = Path(args[args.index("--dir") + 1]) if "--dir" in args else img.parent
if "unsolvable" in img.name:
    sys.exit(1)
w = json.loads((ROOT / "gallery/sample-data/stacks/M_31/M_31_master_IRCUT_siril.meta.json").read_text())["wcs"]
cards = {"CTYPE1": "RA---TAN", "CTYPE2": "DEC--TAN", "CRVAL1": w["crval"][0], "CRVAL2": w["crval"][1],
         "CRPIX1": w["crpix"][0] + 1, "CRPIX2": w["crpix"][1] + 1,
         "CD1_1": w["cd"][0][0], "CD1_2": w["cd"][0][1], "CD2_1": w["cd"][1][0], "CD2_2": w["cd"][1][1],
         "IMAGEW": 1920, "IMAGEH": 1080}
write_minimal_fits(out / (img.stem + ".wcs"), cards)
