# Konfiguration fuer siril-auto.sh  (Ablage: /etc/siril-auto.env)

# --- Seestar-Abholung per rclone (SMB, kein Kernel-Mount noetig) ---
# rclone-Remote-Name (siehe README: rclone config create seestar smb ...)
RCLONE_REMOTE="seestar"
# Pfad auf dem Seestar-Share bis zum Ordner mit den Zielen
# (Share-Name mit "smbclient -L //<seestar-ip> -N" pruefen)
RCLONE_SRC_PATH="EMMC Images/MyWorks"
# IP des Seestar (fuer den Erreichbarkeits-Check, Port 445)
SEESTAR_IP="192.168.1.XX"

# --- Mehrere Geraete (optional) ---
# Ohne DEVICES gibt es genau ein Geraet ("s50") mit den Einstellungen oben.
# Weitere Geraete: ID in DEVICES aufnehmen (a-z, 0-9) und DEV_<id>_* setzen.
# Das erste Geraet ist das Hauptgeraet; Dateien weiterer Geraete heissen <ziel>_<nacht>_<filter>_<id>_siril.
#DEVICES="s50 s30"
#DEV_s50_LABEL="Seestar S50"
#DEV_s30_LABEL="Seestar S30 Pro"
#DEV_s30_IP="192.168.1.XX"
#DEV_s30_REMOTE="seestar30"                 # rclone config create seestar30 smb host=<ip> user=guest
#DEV_s30_SRC="EMMC Images/MyWorks"
#DEV_s30_MIRROR="${ASTRO_ROOT}/raw/s30"     # Default: raw/<id>
#DEV_s30_SCRIPT=/opt/seestar-astro-pipeline/siril/seestar_stack.ssf

# --- Ablage auf dem NAS-Volume (Bind-Mount /data) ---
ASTRO_ROOT="/data/astro"
MIRROR_DIR="${ASTRO_ROOT}/raw/seestar"   # 1:1-Kopie des Seestar (Archiv, nie loeschen)
WORK_DIR="${ASTRO_ROOT}/work"            # temporaer, wird nach Erfolg geleert
STACK_DIR="${ASTRO_ROOT}/stacks"         # lineare Siril-FITS
EXPORT_DIR="${ASTRO_ROOT}/export"        # JPG fuer Immich (External Library)
STATE_DIR="${ASTRO_ROOT}/.state"         # Merker, welche Naechte verarbeitet sind

# --- Siril ---
# Scripte, Katalog und Python-Helfer liegen standardmaessig neben siril-auto.sh
# (Repo unter /opt/seestar-astro-pipeline). Nur bei abweichender Ablage setzen:
#SIRIL_SCRIPT=/opt/seestar-astro-pipeline/siril/seestar_stack.ssf
#SIRIL_MASTER_SCRIPT=/opt/seestar-astro-pipeline/siril/seestar_master.ssf
#SIRIL_SOLVE_SCRIPT=/opt/seestar-astro-pipeline/siril/seestar_solve.ssf
#CATALOG=/opt/seestar-astro-pipeline/siril/data/NGC.csv   # OpenNGC (siehe README)
ALIAS_FILE="/etc/siril-auto.aliases"   # Zielnamen vereinheitlichen
MIN_FRAMES=20            # Naechte mit weniger Frames werden uebersprungen
DEFAULT_EXPOSURE=10      # falls die Belichtung nicht im Dateinamen steht
KEEP_WORK_ON_ERROR=1     # bei Fehler Arbeitsordner zur Analyse behalten

# --- Master ueber mehrere Naechte (je Ziel + Filter) ---
MASTER_MIN_NIGHTS=2
MASTER_STACK_METHOD="rej n"   # bei wenigen Nacht-Stacks keine Rejection

# --- Plate-Solving + meta.json fuer die Galerie ---
PLATESOLVE=1
SOLVE_ARGS="-noflip"
WRITE_META=1
NO_FLIP_Y=0              # 1, falls das Overlay vertikal gespiegelt erscheint
ANNOTATE=1               # beschriftete Version *_beschriftet.jpg fuer Immich

# --- Optional: Immich (Library-Scan, Versionen stapeln, Album) ---
IMMICH_SYNC=0
IMMICH_URL="http://192.168.1.XX:2283"
IMMICH_API_KEY=""                       # Immich → Kontoeinstellungen → API-Schlüssel
IMMICH_LIBRARY_ID=""                    # ID der External Library auf /data/astro/export
IMMICH_ALBUM="Astro"
IMMICH_APP_PATTERN="seestar|stack"      # Dateinamen der App-Stacks vom Handy
TZ_LOCAL="Europe/Berlin"

# --- Optional: Galerie nach neuen Stacks neu bauen (leer = aus) ---
GALLERY_BUILD="/opt/seestar-astro-pipeline/gallery/build/gallery_build.py"   # leer = aus
GALLERY_OUT="${ASTRO_ROOT}/web"

# --- Optional: Status per MQTT an Home Assistant ---
MQTT_ENABLED=1
MQTT_HOST="192.168.1.XX"
MQTT_PORT=1883
MQTT_USER=""
MQTT_PASS=""
MQTT_TOPIC="seestar/siril"
